#include <iostream>
using namespace std;

struct Node {
    int data;
    Node *left, *right;

    Node(int value) {
        data = value;
        left = right = NULL;
    }
};

Node* insert(Node* root, int value) {
    if (root == NULL)
        return new Node(value);

    if (value < root->data)
        root->left = insert(root->left, value);
    else
        root->right = insert(root->right, value);

    return root;
}

void findKth(Node* root, int k, int &count,
             int &answer) {
    if (root == NULL || count >= k)
        return;

    findKth(root->left, k, count, answer);

    count++;

    if (count == k) {
        answer = root->data;
        return;
    }

    findKth(root->right, k, count, answer);
}

int main() {
    Node* root = NULL;
    int n, value, k, count = 0, answer = -1;

    cout << "Enter number of elements: ";
    cin >> n;

    if (n <= 0) {
        cout << "Invalid number of elements.";
        return 0;
    }

    cout << "Enter elements: ";
    for (int i = 0; i < n; i++) {
        cin >> value;
        root = insert(root, value);
    }

    cout << "Enter k: ";
    cin >> k;

    if (k < 1 || k > n) {
        cout << "Invalid value of k.";
    } else {
        findKth(root, k, count, answer);
        cout << "Kth smallest element: "
             << answer;
    }

    return 0;
}
