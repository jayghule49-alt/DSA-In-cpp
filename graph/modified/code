#include <iostream>
#include <climits>
using namespace std;

#define MAX 20

int main()
{
    int n, cost[MAX][MAX];
    int visited[MAX];
    int i, j, edges;
    int min, u, v, totalCost;

    cout << "Enter number of airport facilities: ";
    cin >> n;

    cout << "Enter the cost matrix (0 for no edge):\n";

    for (i = 0; i < n; i++)
    {
        for (j = 0; j < n; j++)
        {
            cin >> cost[i][j];
        }
    }

    int a, b, newWeight;

    cout << "\nEnter edge vertices to update: ";
    cin >> a >> b;

    cout << "Enter new edge weight: ";
    cin >> newWeight;

    if (a < 1 || a > n || b < 1 || b > n || a == b)
    {
        cout << "Invalid vertices!\n";
        return 0;
    }

    if (cost[a - 1][b - 1] == 0)
    {
        cout << "Edge does not exist!\n";
        return 0;
    }

    cost[a - 1][b - 1] = newWeight;
    cost[b - 1][a - 1] = newWeight;

    cout << "\nUpdated edge weight successfully.\n";
    cout << "\nSelected Edges and Running Total:\n";

    for (i = 0; i < n; i++)
        visited[i] = 0;

    visited[0] = 1;
    edges = 0;
    totalCost = 0;

    while (edges < n - 1)
    {
        min = INT_MAX;
        u = -1;
        v = -1;

        for (i = 0; i < n; i++)
        {
            if (visited[i])
            {
                for (j = 0; j < n; j++)
                {
                    if (!visited[j] && cost[i][j] > 0
                        && cost[i][j] < min)
                    {
                        min = cost[i][j];
                        u = i;
                        v = j;
                    }
                }
            }
        }

        if (u == -1)
        {
            cout << "\nGraph is disconnected!\n";
            cout << "Minimum Spanning Tree cannot be formed.\n";
            return 0;
        }

        totalCost += min;
        visited[v] = 1;
        edges++;

        cout << u + 1 << " - " << v + 1
             << " | Weight: " << min
             << " | Running Total: " << totalCost << endl;
    }

    cout << "\nMinimum Spanning Tree formed successfully.\n";
    cout << "Total Minimum Cost = " << totalCost << endl;

    return 0;
}
