
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

struct Employee {
    int id;
    char name[50];
    float salary;
    struct Employee *prev, *next;
};

struct Employee *head = NULL;

struct Employee *createEmployee() {
    struct Employee *newNode =
        (struct Employee *)malloc(sizeof(struct Employee));

    if (newNode == NULL) {
        printf("Memory allocation failed!\n");
        exit(1);
    }

    printf("Enter Employee ID: ");
    scanf("%d", &newNode->id);

    printf("Enter Employee Name: ");
    scanf(" %49[^\n]", newNode->name);

    printf("Enter Salary: ");
    scanf("%f", &newNode->salary);

    newNode->prev = newNode->next = NULL;
    return newNode;
}

void insertBeginning() {
    struct Employee *newNode = createEmployee();

    if (head == NULL) {
        head = newNode;
        newNode->next = newNode->prev = newNode;
    } else {
        struct Employee *last = head->prev;

        newNode->next = head;
        newNode->prev = last;
        last->next = newNode;
        head->prev = newNode;
        head = newNode;
    }

    printf("Employee inserted at beginning.\n");
}

void insertEnd() {
    struct Employee *newNode = createEmployee();

    if (head == NULL) {
        head = newNode;
        newNode->next = newNode->prev = newNode;
    } else {
        struct Employee *last = head->prev;

        newNode->next = head;
        newNode->prev = last;
        last->next = newNode;
        head->prev = newNode;
    }

    printf("Employee inserted at end.\n");
}

void displayForward() {
    if (head == NULL) {
        printf("No employee records.\n");
        return;
    }

    struct Employee *temp = head;

    printf("\nEmployee Records (Forward):\n");
    do {
        printf("ID: %d | Name: %s | Salary: %.2f\n",
               temp->id, temp->name, temp->salary);
        temp = temp->next;
    } while (temp != head);
}

void displayBackward() {
    if (head == NULL) {
        printf("No employee records.\n");
        return;
    }

    struct Employee *temp = head->prev;

    printf("\nEmployee Records (Backward):\n");
    do {
        printf("ID: %d | Name: %s | Salary: %.2f\n",
               temp->id, temp->name, temp->salary);
        temp = temp->prev;
    } while (temp != head->prev);
}

void searchEmployee() {
    if (head == NULL) {
        printf("No employee records.\n");
        return;
    }

    int id;
    printf("Enter Employee ID to search: ");
    scanf("%d", &id);

    struct Employee *temp = head;

    do {
        if (temp->id == id) {
            printf("Employee found!\n");
            printf("ID: %d | Name: %s | Salary: %.2f\n",
                   temp->id, temp->name, temp->salary);
            return;
        }
        temp = temp->next;
    } while (temp != head);

    printf("Employee not found.\n");
}

void deleteEmployee() {
    if (head == NULL) {
        printf("No employee records to delete.\n");
        return;
    }

    int id;
    printf("Enter Employee ID to delete: ");
    scanf("%d", &id);

    struct Employee *temp = head;

    do {
        if (temp->id == id) {
            if (temp->next == temp) {
                head = NULL;
            } else {
                temp->prev->next = temp->next;
                temp->next->prev = temp->prev;

                if (temp == head)
                    head = temp->next;
            }

            free(temp);
            printf("Employee deleted successfully.\n");
            return;
        }
        temp = temp->next;
    } while (temp != head);

    printf("Employee not found.\n");
}

void freeList() {
    if (head == NULL)
        return;

    struct Employee *temp = head->next;

    while (temp != head) {
        struct Employee *nextNode = temp->next;
        free(temp);
        temp = nextNode;
    }

    free(head);
    head = NULL;
}

int main() {
    int choice;

    do {
        printf("\n--- Employee Record Management ---\n");
        printf("1. Insert at Beginning\n");
        printf("2. Insert at End\n");
        printf("3. Delete Employee\n");
        printf("4. Search Employee\n");
        printf("5. Display Forward\n");
        printf("6. Display Backward\n");
        printf("7. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                insertBeginning();
                break;
            case 2:
                insertEnd();
                break;
            case 3:
                deleteEmployee();
                break;
            case 4:
                searchEmployee();
                break;
            case 5:
                displayForward();
                break;
            case 6:
                displayBackward();
                break;
            case 7:
                freeList();
                printf("Exiting program.\n");
                break;
            default:
                printf("Invalid choice! Try again.\n");
        }
    } while (choice != 7);

    return 0;
}
